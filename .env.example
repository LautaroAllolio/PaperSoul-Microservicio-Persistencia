# Configuración del microservicio. Copiar a .env y ajustar.
# NUNCA commitear el .env real: ver SPEC.md §7 (Boundaries → Nunca).

# --- MongoDB -----------------------------------------------------------------
# Sin autenticación: el servicio está pensado para red interna (SPEC.md §1.1 D-3).
# En producción, usar credenciales vía variable de entorno o secret manager.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=papersoul

# --- Aplicación --------------------------------------------------------------
LOG_LEVEL=INFO

# Prefijo URN de los tipos de problema RFC 9457.
# Cambiarlo es un BREAKING CHANGE para los clientes que hacen switch sobre `type`.
PROBLEM_TYPE_BASE=urn:problem:papersoul
